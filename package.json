{
  "name": "mailflare",
  "version": "0.1.0",
  "description": "Ink TUI and CLI for Cloudflare Email Routing",
  "type": "module",
  "bin": {
    "mailflare": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "string-width": "^8.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.4.0",
    "@types/react": "^18.3.24",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.34.0"
  },
  "engines": {
    "node": ">=20"
  }
}